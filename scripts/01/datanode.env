# datanode.env: specific hadoop datanode environment, called from ~/.bashrc on each particular datanode, but not on namenode

if [ ! -n "$SSH_CLIENT" ]; then
   echo "$(date): WARNING: SSH_CLIENT environment variable not set, cannot start proper datanode"
else
   DN=$(echo $SSH_CLIENT | cut -d' ' -f1)
   export HADOOP_CONF_DIR=${HADOOP_HOME}/etc/datanode${DN}
   # this directory stores the pid-File for the currently running process - this needs to be different for each datanode,
   # otherwise the system would tell, that process is already running, when a different student started his datanode instance
   export HADOOP_PID_DIR=/usr/local/hadoop/hadoopdata/datanode${DN}/tmp
   # and it is helpful to have individual log directories for tracking potential errors
   export HADOOP_LOG_DIR=${HADOOP_HOME}/logs/datanode${DN}
   echo "$(date): HADOOP_CONF_DIR(${SSH_CLIENT})=${HADOOP_CONF_DIR}"
fi